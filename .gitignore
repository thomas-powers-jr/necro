node_modules/
dist/
/coverage/
*.log
.DS_Store
HANDOFF.md.resumed-*
*.consumed-*

# Local MCP tool trust grants (per-machine, per-installed-version — see
# `cadence mcp trust grant`); never shared across machines/worktrees.
.cadence/mcp-trust.json

# Local secrets — never commit the real .env (template is .env.example)
.env
.env.*
!.env.example

# Local scratch (eval/run output dumps)
dumpfile

# Local CADENCE intelligence context (derived, regenerated). Handoff SESSION
# docs are NOT ignored — they're committed by the /handoff skill so the other
# PC / sibling worktrees can see them (see mane-horizons-cloud's 2026-07-08/09
# handoff/resume overhaul for why the old blanket-ignore here was wrong).
.cadence/intelligence/

# Local pre-launch planning docs — kept local, not part of the shipped repo
docs/launch/

# Competitor-bench external repo checkouts (maintainer-run, never committed)
.bench-cache/

# necro's own symbol-graph cache (phase 58) — derived/disposable, written
# wherever a test or manual run scans a target in place, including nested
# under test/fixtures/ real-repo corpora (those tests scan in place, not via
# a tmpdir copy).
**/.necro-cache/

# test/library-exports.test.ts's scratch dir for self-reference resolution
# checks — must live inside the repo (not the OS tmpdir) so Node/tsc's
# package self-reference walk-up finds this repo's own package.json.
.tmp-lib-check-*/
